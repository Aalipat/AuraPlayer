# =============================================================================
# YouTube & Spotify Downloader - Configuration Template (.env.example)
# =============================================================================
# Copy this file to .env and configure as needed:
# cp .env.example .env

# Telegram Bot Token (Optional for web/desktop panel, required only for Telegram bot)
BOT_TOKEN=your_telegram_bot_token_here

# Proxy URL (auto = auto-detect working proxy port or direct, direct = force direct, or custom e.g. http://127.0.0.1:10808)
PROXY_URL=auto

# Fallback Proxy URL if primary fails
PROXY_FALLBACK_URL=

# Download storage path (default: data/downloads)
DOWNLOAD_DIR=data/downloads

# Transcript storage path (default: data/transcripts)
TRANSCRIPT_DIR=data/transcripts

# Maximum file size before compression (in MB, Telegram bot API limit is 50MB)
MAX_FILE_SIZE_MB=48
